{
    "name": "@frappeforge/client",
    "version": "0.0.0",
    "description": "Zero-dependency, fetch-native TypeScript client for the Frappe Framework REST API.",
    "license": "MIT",
    "type": "module",
    "sideEffects": false,
    "engines": {
        "node": ">=22.12"
    },
    "keywords": [
        "frappe",
        "frappe-framework",
        "erpnext",
        "rest",
        "api-client",
        "sdk",
        "typescript",
        "fetch",
        "zero-dependency"
    ],
    "homepage": "https://github.com/frappeforge/frappeforge/tree/main/packages/client#readme",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/frappeforge/frappeforge.git",
        "directory": "packages/client"
    },
    "bugs": {
        "url": "https://github.com/frappeforge/frappeforge/issues"
    },
    "files": [
        "dist",
        "README.md",
        "CHANGELOG.md",
        "LICENSE"
    ],
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./package.json": "./package.json"
    },
    "scripts": {
        "build": "tsdown && node scripts/verify-dist.mjs",
        "test": "vitest run --coverage",
        "test:watch": "vitest",
        "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json && tsc --noEmit -p tests/register/tsconfig.json",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "api:extract": "api-extractor run --local",
        "api:check": "api-extractor run",
        "publint": "publint"
    },
    "publishConfig": {
        "access": "public",
        "provenance": true
    }
}
