{
    "name": "@frappeforge/codegen",
    "version": "0.0.0",
    "private": true,
    "description": "Generates TypeScript types for your Frappe DocTypes from a live site.",
    "license": "MIT",
    "type": "module",
    "sideEffects": false,
    "engines": {
        "node": ">=22"
    },
    "keywords": [
        "frappe",
        "frappe-framework",
        "erpnext",
        "doctype",
        "codegen",
        "typescript",
        "types",
        "cli"
    ],
    "homepage": "https://github.com/frappeforge/frappeforge/tree/main/packages/codegen#readme",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/frappeforge/frappeforge.git",
        "directory": "packages/codegen"
    },
    "bugs": {
        "url": "https://github.com/frappeforge/frappeforge/issues"
    },
    "files": [
        "dist",
        "README.md",
        "CHANGELOG.md",
        "LICENSE"
    ],
    "bin": {
        "frappeforge-codegen": "./dist/cli.js"
    },
    "main": "./dist/index.cjs",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            },
            "require": {
                "types": "./dist/index.d.cts",
                "default": "./dist/index.cjs"
            }
        },
        "./package.json": "./package.json"
    },
    "scripts": {
        "build": "tsdown && node scripts/verify-dist.mjs",
        "test": "vitest run --coverage",
        "test:watch": "vitest",
        "typecheck": "tsc --noEmit -p tsconfig.json",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "api:extract": "api-extractor run --local",
        "api:check": "api-extractor run",
        "publint": "publint",
        "attw": "attw --pack . --profile node16"
    },
    "publishConfig": {
        "access": "public",
        "provenance": true
    }
}
