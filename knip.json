{
    "$schema": "https://unpkg.com/knip@latest/schema.json",
    "workspaces": {
        ".": {
            "entry": ["scripts/*.mjs", "*.shared.ts"],
            "project": ["scripts/**", "*.shared.ts"]
        },
        "packages/*": {
            "entry": ["src/index.ts", "scripts/*.mjs", "tests/**/*.test-d.ts"],
            "project": ["src/**", "tests/**", "scripts/**"]
        },
        "packages/codegen": {
            "entry": ["src/index.ts", "scripts/*.mjs", "tests/**/*.test-d.ts", "tests/golden/*.generated.ts"],
            "project": ["src/**", "tests/**", "scripts/**"]
        }
    }
}
